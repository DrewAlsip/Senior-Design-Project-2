
#include <Wire.h>
#include <Adafruit_ICM20948.h>
#include <Adafruit_Sensor.h>

Adafruit_ICM20948 imu;

// Target sampling interval:
// 10,000 microseconds = 10 milliseconds = 100 Hz
const uint32_t SAMPLE_INTERVAL_US = 10000;

uint32_t nextSampleTime = 0;

void setup() {

  // Start USB serial communication
  Serial.begin(115200);

  // Start I2C communication
  Wire.begin();

  Serial.println("IMU Test Starting");

  // Initialize the ICM-20948
  if (!imu.begin_I2C()) {

    Serial.println("IMU not detected!");

    while (1) {
      delay(10);
    }
  }

  Serial.println("IMU connected!");

  // CSV column headings
  Serial.println(
    "Timestamp_us,"
    "Accel_X,Accel_Y,Accel_Z,"
    "Gyro_X,Gyro_Y,Gyro_Z,"
    "Mag_X,Mag_Y,Mag_Z"
  );

  // Schedule the first sample
  nextSampleTime = micros();
}

void loop() {

  uint32_t currentTime = micros();

  // Check whether it is time for another sample
  if ((int32_t)(currentTime - nextSampleTime) >= 0) {

    // Schedule the next sample
    nextSampleTime += SAMPLE_INTERVAL_US;

    // Record timestamp
    uint32_t timestamp = micros();

    // Create sensor measurement variables
    sensors_event_t accel;
    sensors_event_t gyro;
    sensors_event_t temp;
    sensors_event_t mag;

    // Retrieve all IMU measurements
    imu.getEvent(&accel, &gyro, &temp, &mag);

    // Print timestamp
    Serial.print(timestamp);
    Serial.print(",");

    // Acceleration (m/s^2)
    Serial.print(accel.acceleration.x, 4);
    Serial.print(",");
    Serial.print(accel.acceleration.y, 4);
    Serial.print(",");
    Serial.print(accel.acceleration.z, 4);
    Serial.print(",");

    // Angular velocity (rad/s)
    Serial.print(gyro.gyro.x, 4);
    Serial.print(",");
    Serial.print(gyro.gyro.y, 4);
    Serial.print(",");
    Serial.print(gyro.gyro.z, 4);
    Serial.print(",");

    // Magnetic field (microtesla)
    Serial.print(mag.magnetic.x, 4);
    Serial.print(",");
    Serial.print(mag.magnetic.y, 4);
    Serial.print(",");
    Serial.println(mag.magnetic.z, 4);
  }
}
