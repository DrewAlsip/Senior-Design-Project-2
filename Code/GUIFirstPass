import sys
import serial

from PyQt6.QtWidgets import (
    QApplication,
    QWidget,
    QVBoxLayout,
    QLabel,
    QPushButton
)

from PyQt6.QtCore import QTimer


class MainWindow(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Localization Device GUI")

        # Serial port starts disconnected
        self.serial_port = None

        # GPS Labels
        self.latitude_label = QLabel("Latitude: N/A")
        self.longitude_label = QLabel("Longitude: N/A")
        self.altitude_label = QLabel("Altitude: N/A")
        self.satellites_label = QLabel("Satellites: N/A")

        # Accelerometer Labels
        self.accel_x_label = QLabel("Accel X: N/A")
        self.accel_y_label = QLabel("Accel Y: N/A")
        self.accel_z_label = QLabel("Accel Z: N/A")

        # Gyroscope Labels
        self.gyro_x_label = QLabel("Gyro X: N/A")
        self.gyro_y_label = QLabel("Gyro Y: N/A")
        self.gyro_z_label = QLabel("Gyro Z: N/A")

        # Magnetometer Labels
        self.mag_x_label = QLabel("Mag X: N/A")
        self.mag_y_label = QLabel("Mag Y: N/A")
        self.mag_z_label = QLabel("Mag Z: N/A")

        # Status Label
        self.status_label = QLabel("Status: Disconnected")

        # Buttons
        self.start_button = QPushButton("Start Display")
        self.exit_button = QPushButton("Exit")

        self.start_button.clicked.connect(self.start_display)
        self.exit_button.clicked.connect(self.close)

        # Timer for serial updates
        self.timer = QTimer()
        self.timer.timeout.connect(self.read_serial_data)

        # Layout
        layout = QVBoxLayout()

        layout.addWidget(self.status_label)

        layout.addWidget(self.latitude_label)
        layout.addWidget(self.longitude_label)
        layout.addWidget(self.altitude_label)
        layout.addWidget(self.satellites_label)

        layout.addWidget(self.accel_x_label)
        layout.addWidget(self.accel_y_label)
        layout.addWidget(self.accel_z_label)

        layout.addWidget(self.gyro_x_label)
        layout.addWidget(self.gyro_y_label)
        layout.addWidget(self.gyro_z_label)

        layout.addWidget(self.mag_x_label)
        layout.addWidget(self.mag_y_label)
        layout.addWidget(self.mag_z_label)

        layout.addWidget(self.start_button)
        layout.addWidget(self.exit_button)

        self.setLayout(layout)

    def start_display(self):
        try:
            self.serial_port = serial.Serial(
                port="COM4",      # Replace with actual COM port
                baudrate=115200,
                timeout=0.1
            )

            self.status_label.setText("Status: Connected")
            self.timer.start(50)

        except Exception as e:
            self.status_label.setText(f"Connection Error: {e}")
    
    def read_serial_data(self):

        if self.serial_port is None:
            return

        newest_line = None

        try:
            # Read everything waiting in the buffer
            while self.serial_port.in_waiting:
                newest_line = (
                    self.serial_port.readline()
                    .decode(errors="ignore")
                    .strip()
                )

            # Nothing received
            if newest_line is None:
                return

            print(newest_line)  # Optional for debugging

            fields = newest_line.split(',')

            if len(fields) < 13:
                return

            self.latitude_label.setText(
                f"Latitude: {fields[0]}"
            )

            self.longitude_label.setText(
                f"Longitude: {fields[1]}"
            )

            self.altitude_label.setText(
                f"Altitude: {fields[2]}"
            )

            self.satellites_label.setText(
                f"Satellites: {fields[3]}"
            )

            self.accel_x_label.setText(
                f"Accel X: {fields[4]}"
            )

            self.accel_y_label.setText(
                f"Accel Y: {fields[5]}"
            )

            self.accel_z_label.setText(
                f"Accel Z: {fields[6]}"
            )

            self.gyro_x_label.setText(
                f"Gyro X: {fields[7]}"
            )

            self.gyro_y_label.setText(
                f"Gyro Y: {fields[8]}"
            )

            self.gyro_z_label.setText(
                f"Gyro Z: {fields[9]}"
            )

            self.mag_x_label.setText(
                f"Mag X: {fields[10]}"
            )

            self.mag_y_label.setText(
                f"Mag Y: {fields[11]}"
            )

            self.mag_z_label.setText(
                f"Mag Z: {fields[12]}"
            )

        except Exception as e:
            self.status_label.setText(
                f"Read Error: {e}"
            )


app = QApplication(sys.argv)

window = MainWindow()
window.show()

sys.exit(app.exec())
