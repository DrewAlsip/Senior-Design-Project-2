
#include <TinyGPSPlus.h>

TinyGPSPlus gps;

#define GPS_BAUDRATE 9600
#define RXD2 16
#define TXD2 17

// Variables for measuring incoming GPS data
unsigned long lastStatsTime = 0;
unsigned long lastCharsProcessed = 0;
unsigned long charsPerSecond = 0;

void setup()
{
    Serial.begin(115200);

    // Initialize GPS communication
    Serial1.begin(GPS_BAUDRATE, SERIAL_8N1, RXD2, TXD2);

    Serial.println("GPS Test Starting");
}

void loop()
{
    // Read incoming GPS data
    while (Serial1.available())
    {
        gps.encode(Serial1.read());
    }

    // Calculate characters received per second
    if (millis() - lastStatsTime >= 1000)
    {
        unsigned long currentChars = gps.charsProcessed();

        charsPerSecond = currentChars - lastCharsProcessed;

        lastCharsProcessed = currentChars;
        lastStatsTime = millis();
    }

    // Print GPS information when location updates
    if (gps.location.isUpdated())
    {
        // Print GPS timestamp (UTC)
        Serial.print("GPS Time: ");

        if (gps.time.isValid())
        {
            if (gps.time.hour() < 10) Serial.print("0");
            Serial.print(gps.time.hour());
            Serial.print(":");

            if (gps.time.minute() < 10) Serial.print("0");
            Serial.print(gps.time.minute());
            Serial.print(":");

            if (gps.time.second() < 10) Serial.print("0");
            Serial.print(gps.time.second());

            Serial.println(" UTC");
        }
        else
        {
            Serial.println("Unavailable");
        }

        // Print latitude
        Serial.print("Latitude: ");
        Serial.println(gps.location.lat(), 6);

        // Print longitude
        Serial.print("Longitude: ");
        Serial.println(gps.location.lng(), 6);

        // Print altitude
        Serial.print("Altitude (m): ");
        Serial.println(gps.altitude.meters());

        // Print satellite count
        Serial.print("Satellites: ");
        Serial.println(gps.satellites.value());

        // Print HDOP
        Serial.print("HDOP: ");
        Serial.println(gps.hdop.value());

        // Print total characters processed
        Serial.print("Total Characters Processed: ");
        Serial.println(gps.charsProcessed());

        // Print incoming characters per second
        Serial.print("Characters Per Second: ");
        Serial.println(charsPerSecond);

        Serial.println("------------------");
    }
}
